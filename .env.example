# Copy this file to ".env" (same folder as app.py) and fill it in. Never share or commit .env.

# Which AI to use: ollama (local, offline) or gemini (cloud, free key).
# You can also switch any time from the tray icon; that choice is remembered in settings.json.
CLICKY_PROVIDER=gemini

# Free key (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional: use whichever model your AI Studio key lists.
# CLICKY_GEMINI_MODEL=gemini-2.5-flash

# Optional Ollama settings
# CLICKY_MODEL=llava:7b
